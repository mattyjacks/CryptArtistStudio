{
  "name": "CryptArtist Studio - Chromebook Edition",
  "short_name": "CryptArtist",
  "description": "Creative suite with VibeCodeWorker, MediaMogul, and more - optimized for Chromebooks",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#1a1a2e",
  "background_color": "#0f0f1e",
  "categories": ["productivity", "development"],
  "screenshots": [
    {
      "src": "/screenshots/vcw-mobile.png",
      "sizes": "540x720",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "/screenshots/vcw-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide"
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "VibeCodeWorker",
      "short_name": "Code",
      "description": "Open VibeCodeWorker code editor",
      "url": "/vibecode-worker",
      "icons": [
        {
          "src": "/icons/vcw-icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "MediaMogul",
      "short_name": "Media",
      "description": "Open MediaMogul media editor",
      "url": "/media-mogul",
      "icons": [
        {
          "src": "/icons/mm-icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "GameStudio",
      "short_name": "Games",
      "description": "Open GameStudio game creator",
      "url": "/game-studio",
      "icons": [
        {
          "src": "/icons/gs-icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["*/*"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/open-file",
      "accept": {
        "application/json": [".json"],
        "text/plain": [".txt", ".md", ".js", ".ts", ".tsx", ".jsx", ".py", ".rs", ".go"],
        "application/x-cryptart": [".cryptart", ".CryptArt"]
      },
      "launch_type": "single-client"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+cryptart",
      "url": "/open?url=%s"
    }
  ],
  "prefer_related_applications": false
}
