# ============================================================================
# CryptArtist Studio v2 - Environment Variables Configuration
# ============================================================================

# 1. Access Passwords & Role-Based Access Control (RBAC)
# ADMIN_PASSWORD grants full access to all 15 suite programs, Master Dashboard, VibeCodeWorker, and AI Vault.
ADMIN_PASSWORD=admin2026

# MEDIA_MOGUL_PASSWORD grants access to Media Mogul video editor and AI auto-edit features.
MEDIA_MOGUL_PASSWORD=mogul2026

# Vite Client-Side Environment Variables (for offline/standalone web builds)
VITE_ADMIN_PASSWORD=admin2026
VITE_MEDIA_MOGUL_PASSWORD=mogul2026

# Optional JSON dictionary for multiple custom user passwords:
# STUDIO_USER_PASSWORDS={"team_editor_1":"media-mogul","director_pass":"admin"}
# STUDIO_USER_PASSWORDS={}

# 2. Server AI Provider Keys (for Password-Gated Vault Proxy)
OPENAI_API_KEY=sk-proj-...
OPENROUTER_KEY=sk-or-v1-...

# 3. Stock Media & Speech API Keys (Optional)
PEXELS_KEY=...
ELEVENLABS_KEY=...
